{
  "name": "dsh-deepai-connector",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "DeepAI Code 模型接入 DeepSeek Harness：浏览器 OAuth 登录直连上游，不需要安装 DeepAI Code 桌面客户端，也不需要额外的网关进程。",
  "author": "REALOIYO <115921813+REALOIYO@users.noreply.github.com> (https://github.com/REALOIYO)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REALOIYO/dsh-deepai-connector.git"
  },
  "homepage": "https://github.com/REALOIYO/dsh-deepai-connector#readme",
  "bugs": {
    "url": "https://github.com/REALOIYO/dsh-deepai-connector/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepai",
    "deepai-code",
    "llm-adapter",
    "llm-provider"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/cordis": "^4.0.2",
    "react": ">=18",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"test/*.test.ts\""
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
